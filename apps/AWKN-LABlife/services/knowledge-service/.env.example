# Knowledge Service 环境变量
# 知识库检索服务（FastAPI，端口 8701）

# BGE embedding 模型配置
# 模型本地路径；如不存在会在首次启动时下载
BGE_MODEL_PATH=BAAI/bge-large-zh-v1.5
BGE_MODEL_CACHE_DIR=./models/bge-large-zh-v1.5
# embedding 维度（BGE-large-zh = 1024）
BGE_EMBED_DIM=1024
# 单批 embedding 大小
BGE_BATCH_SIZE=32

# ChromaDB 向量库
CHROMA_PERSIST_DIR=../../../knowledge/services/chroma_db
# 距离函数：cosine / l2 / ip
CHROMA_DISTANCE_FUNC=cosine

# 检索行为
KNOWLEDGE_TOP_K=6
# 是否启用向量检索（true / false，false 时回退到关键词检索）
USE_EMBED_SEARCH=true
# 混合检索权重（向量 0.7 + 关键词 0.3）
HYBRID_VECTOR_WEIGHT=0.7
HYBRID_KEYWORD_WEIGHT=0.3

# 知识库切换（确保与 execution-framework.md 一致：当前是 SQLite，不提前迁 PG）
DB_PROVIDER=sqlite
