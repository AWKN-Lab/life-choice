server {
    listen 80;
    server_name awkn.cn www.awkn.cn;
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl;
    server_name awkn.cn www.awkn.cn;

    ssl_certificate /etc/nginx/certs/www.awkn.cn.pem;
    ssl_certificate_key /etc/nginx/private/www.awkn.cn.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    location /lingyang/api/ {
        proxy_pass http://127.0.0.1:40000/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 10s;
        proxy_read_timeout 30s;
    }

    location ^~ /lingyang/images/exercises/ {
        alias /opt/lingyang/external/free-exercise-db-main/exercises/;
    }

    location ^~ /lingyang/gifs/ {
        alias /www/wwwroot/awkn.cn/lingyang/gifs/;
    }

    location ^~ /lingyang/images/public/gifs/ {
        alias /www/wwwroot/awkn.cn/lingyang/frontend/assets/exercise-gifs/;
    }

    location ^~ /lingyang/images/ {
        alias /www/wwwroot/awkn.cn/lingyang/images/;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    location ^~ /lingyang/free-exercise-db/ {
        alias /opt/lingyang/external/free-exercise-db-main/;
    }

    location ^~ /free-exercise-db/ {
        alias /opt/lingyang/external/free-exercise-db-main/;
    }

    location ^~ /lingyang/h5/body-map/ {
        alias /www/wwwroot/awkn.cn/lingyang/h5/body-map/;
        index index.html;
        try_files $uri $uri/ =404;
    }

    location /lingyang/ {
        alias /www/wwwroot/awkn.cn/lingyang/;
        index index.html;
        try_files $uri $uri/ /lingyang/dist/index.html;
    }

    location /life/api/ {
        proxy_pass http://127.0.0.1:3000/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 300s;
    }

    location ^~ /life/assets/ {
        alias /www/wwwroot/awkn-lab/life/assets/;
        try_files $uri =404;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # SPA fallback: 非 assets 的 /life/ 请求都回退到 index.html
    location ^~ /life/ {
        alias /www/wwwroot/awkn-lab/life/;
        index index.html;
        try_files $uri $uri/ @life_spa;
    }

    # SPA 命名 fallback，避免 alias + try_files 循环
    location @life_spa {
        root /www/wwwroot/awkn-lab;
        try_files /life/index.html =404;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:30000/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location / {
        root /www/wwwroot/awkn-lab;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}
