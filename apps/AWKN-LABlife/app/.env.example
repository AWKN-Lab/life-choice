# ==========================================
# 人生决策宗师 - 前端环境变量
# 开发环境使用
# ==========================================

# API 地址
VITE_API_BASE_URL=http://localhost:30001/api/v1

# 是否使用 Mock 数据（开发后端未就绪时设为 true）
VITE_USE_MOCK=false

# 邀请分享域名（不带尾斜杠），用于生成 ProfilePage 邀请链接/KLine 分享卡片/海报二维码
VITE_INVITE_DOMAIN=https://awkn.cn

# Sentry 错误监控（可选，留空则不启用）
VITE_SENTRY_DSN=
