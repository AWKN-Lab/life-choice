# Database (SQLite - 与 schema.prisma 保持一致)
DATABASE_URL="file:./dev.db"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ==================== LLM Providers ====================
# 支持多 Provider 自动切换，按优先级：doubao > kimi > minimax > openai

# 豆包 (Volcengine)
DOUBAO_API_KEY="your-doubao-api-key"
DOUBAO_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"
DOUBAO_MODEL="doubao-seed-2-0-pro-260215"

# KIMI (Moonshot) - 首选
KIMI_API_KEY="your-kimi-api-key"
KIMI_MODEL="moonshot-v1-8k"

# DeepSeek Direct (默认 Provider)
DEEPSEEK_DIRECT_API_KEY="your-deepseek-api-key"
DEEPSEEK_DIRECT_BASE_URL="https://api.deepseek.com/v1"
DEEPSEEK_DIRECT_MODEL="deepseek-v4-flash"

# MINIMAX
# 文档: https://platform.minimaxi.com/docs/api-reference/text-openai-api
# Base URL: https://api.minimaxi.com/v1
# 模型: MiniMax-M2.7 / MiniMax-M2.5 / MiniMax-M2.1 等
# 注意: temperature 必须设置为 1.0
MINIMAX_API_KEY="your-minimax-api-key"
MINIMAX_MODEL="MiniMax-M2.7"

# 默认 LLM Provider
DEFAULT_LLM_PROVIDER="deepseek-direct"

# 辅助任务 Provider（记忆提取/主动问候等走便宜 provider）
CHEAP_LLM_PROVIDER="sensenova"

# OpenAI (备用)
OPENAI_API_KEY="sk-your-openai-api-key"
OPENAI_MODEL="gpt-4o"

# ==================== Payment ====================
# Stripe (for production)
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# WeChat (for production)
WECHAT_APP_ID="wx_your_app_id"
WECHAT_APP_SECRET="your_app_secret"

# Alipay (for production)
ALIPAY_APP_ID="your_alipay_app_id"
ALIPAY_PRIVATE_KEY="your_private_key"
ALIPAY_PUBLIC_KEY="alipay_public_key"

# Environment
NODE_ENV="development"
PORT=3000

# ==================== Python 排盘引擎 ====================
# 紫微斗数 Python CLI 路径
# 本地开发留空（代码会自动查找）；Docker 部署自动设置为 /app/python-engine/paipan_cli.py
# 裸机部署（PM2）时需手动指定，否则会降级到 iztro（精度降低）
ZIWEI_CLI_PATH=
