        "yuanShen": "父母（车船）",
        "jiShen": "官鬼（灾祸）",
        "chouShen": "子孙（平安）",
        "judgment": "出行以世爻为自身安全，官鬼为路上灾祸，子孙为解神",
        "actionDo": ["看世爻是否旺相判断出行状态", "看子孙爻是否发动判断平安"],
        "actionDont": ["官鬼爻发动克世则不宜出行"]
      }
    }
  ]
