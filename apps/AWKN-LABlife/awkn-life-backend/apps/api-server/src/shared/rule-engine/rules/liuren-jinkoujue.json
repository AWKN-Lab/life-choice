    "renYuan": {
      "description": "人元定法：以日干遁五子元遁法起人元",
      "fiveRatEscape": {
        "甲己": "甲子",
        "乙庚": "丙子",
        "丙辛": "戊子",
        "丁壬": "庚子",
        "戊癸": "壬子"
      },
      "calculationRule": "以日干定五子遁，从子时起遁，顺数至贵神地支，所得天干即为人元（第一爻）。例如甲日贵神为寅，甲己起甲子，子为甲、丑为乙、寅为丙，人元为丙"
    }
