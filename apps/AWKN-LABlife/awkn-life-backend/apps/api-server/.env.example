# Server Configuration
PORT=3000
NODE_ENV=development

# P0-1: K线 /seed 写入开关（生产环境强制禁用，仅开发/测试环境设为 true）
ALLOW_SEED_WRITE=false

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# CORS Origins (comma-separated, overrides defaults)
# Defaults include: http://localhost:5173-5177, http://localhost:8080-8088, https://awkn.cn, https://www.awkn.cn
CORS_ORIGINS=

# Database
# 生产环境务必使用绝对路径，避免 Prisma 相对路径解析到多个 SQLite 文件
DATABASE_URL=file:/opt/awkn-life/awkn-life-backend/apps/api-server/prisma/dev.db

# JWT Authentication
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=15m

# LLM Providers (全部密钥必须从环境变量注入，禁止写入代码)
DEFAULT_LLM_PROVIDER=sensenova

# Volcengine Ark shared key for Doubao / DeepSeek endpoints
VOLCENGINE_API_KEY=your_volcengine_ark_key
ARK_API_KEY=your_ark_key_alias

# Kimi (Moonshot)
MOONSHOT_API_KEY=your_moonshot_api_key
KIMI_API_KEY=your_kimi_api_key
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL=moonshot-v1-8k

# Doubao
DOUBAO_API_KEY=your_doubao_api_key
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=your_doubao_endpoint_or_model

# DeepSeek
DEEPSEEK_API_KEY=your_deepseek_or_ark_key
DEEPSEEK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DEEPSEEK_MODEL=deepseek-chat

# MiniMax
MINIMAX_API_KEY=your_minimax_api_key
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-Text-01

# SenseNova (商汤日日新) — DeepSeek V4 Flash
SENSENOVA_API_KEY=your_sensenova_api_key
SENSENOVA_BASE_URL=https://token.sensenova.cn/v1
SENSENOVA_MODEL=deepseek-v4-flash

# DeepSeek Direct (直连 DeepSeek 官方，不走火山)
DEEPSEEK_DIRECT_API_KEY=your_deepseek_direct_api_key
DEEPSEEK_DIRECT_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_DIRECT_MODEL=deepseek-v4-pro

# Spark / Xfyun (讯飞星火 HTTP 推理服务)
SPARK_API_KEY=your_spark_api_key
XFYUN_API_KEY=your_xfyun_api_key
SPARK_BASE_URL=https://maas-api.cn-huabei-1.xf-yun.com/v2
SPARK_MODEL=xopqwen36v35b
SPARK_RESOURCE_ID=0

# OpenAI (兜底)
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Stripe Payment
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# WeChat Payment
WECHAT_APP_ID=wx_your_app_id
WECHAT_MCH_ID=your_mch_id
WECHAT_API_KEY=your_wechat_api_key

# Alipay
ALIPAY_APP_ID=your_alipay_app_id
ALIPAY_PRIVATE_KEY=your_private_key
ALIPAY_PUBLIC_KEY=your_public_key

# Analytics (可选)
ANALYTICS_ENABLED=true

# Sentry Error Monitoring (可选，留空则不启用)
SENTRY_DSN=

# Admin
ADMIN_EMAIL=10919669@qq.com
# Required for bootstrap-production.js and deploy.sh to auto-create admin on first start
ADMIN_PASSWORD=changeme

# Divination Service (Python 算命引擎)
DIVINATION_SERVICE_URL=http://127.0.0.1:5001

# Python 排盘引擎 CLI 路径（紫微斗数排盘）
# Docker 部署时默认为 /app/python-engine/paipan_cli.py
# 本地开发时指向 python-validator 目录
ZIWEI_CLI_PATH=

# LLM Prompt Version
LLM_PROMPT_VERSION=v1

# Feature Flags (可选，默认关闭)
REDIS_ENABLED=true
COST_WARNING_ENABLED=false
COST_CONFIRMATION_ENABLED=false
CALLBACK_ENABLED=false
MEMORY_ANCHOR_ENABLED=false
USER_CLASSIFIER_ENABLED=false
MULTI_TURN_ENABLED=false

# P0-09 (2026-07-12): K线V2 功能开关 — 默认全部关闭，按需开启
# 总开关：控制 K线V2 重构后的新架构是否生效
KLINE_V2_ENABLED=false
# 公开预览：未登录用户能否看到 K线预览
KLINE_V2_PUBLIC_PREVIEW_ENABLED=false
# 节点问事：K线节点是否可进入问事
KLINE_V2_NODE_ASK_ENABLED=false
# 结果回看：K线结果是否写入历史并可回看
KLINE_V2_OUTCOME_ENABLED=false
# 模拟数据：是否允许返回模拟数据（生产环境必须 false）
KLINE_SIMULATED_DATA_ALLOWED=false
