{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "tsconfigPath": "tsconfig.build.json",
    "assets": [
      {
        "include": "**/prompts/*.md",
        "watchAssets": true
      },
      {
        "include": "**/knowledge-base/**/*.json",
        "watchAssets": true
      },
      {
        "include": "**/calc-engine/data/**/*.json",
        "watchAssets": true
      },
      {
        "include": "**/*.yaml",
        "watchAssets": true
      }
    ]
  }
}
