{
  "name": "awkn-life-backend",
  "version": "1.0.0",
  "description": "人生决策宗师后端服务",
  "private": true,
  "scripts": {
    "dev": "cd apps/api-server && npx nest start --watch",
    "build": "cd apps/api-server && npx nest build",
    "start:prod": "node scripts/bootstrap-production.js",
    "postinstall": "cd apps/api-server && npx prisma generate",
    "admin:ensure": "cd apps/api-server && node scripts/ensure-admin.js",
    "eval:golden": "node apps/api-server/scripts/eval-golden.cjs",
    "db:generate": "cd apps/api-server && npx prisma generate",
    "db:push": "cd apps/api-server && npx prisma db push",
    "sync:schema": "node scripts/sync-schema.cjs",
    "test": "cd apps/api-server && npx jest",
    "test:watch": "cd apps/api-server && npx jest --watch",
    "test:cov": "cd apps/api-server && npx jest --coverage",
    "typecheck": "cd apps/api-server && npx tsc --noEmit",
    "lint": "echo \"lint: backend eslint not configured yet (placeholder)\""
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/platform-socket.io": "^10.3.0",
    "@nestjs/websockets": "^10.3.0",
    "@sentry/node": "^8.0.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.76.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dayjs": "^1.11.10",
    "dotenv": "^16.3.0",
    "iching-shifa": "^1.2.0",
    "ioredis": "^5.10.1",
    "iztro": "^2.5.8",
    "js-yaml": "^4.2.0",
    "lunar-javascript": "^1.7.7",
    "openai": "^4.26.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "stripe": "^14.14.0",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/testing": "^10.3.0",
    "@prisma/client": "^5.22.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.0",
    "@types/passport-jwt": "^4.0.1",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "ts-jest": "^29.1.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18"
  }
}
