{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "outDir": "./dist",
    "rootDir": ".",
    "noEmit": true,
    "lib": ["ES2020"]
  },
  "include": ["*.ts"],
  "exclude": ["node_modules", "dist", "*.spec.ts"]
}
