{
  "meta": {"description": "八字命理术语白话翻译库", "version": "1.0.0", "note": "用于智能体输出时将专业术语翻译为用户易懂的语言"},
  "terms": [
    {"term": "正印格", "translation": "月令印星当令，主贵人扶持、学习能力强、适合教育文化类工作", "category": "格局"},
    {"term": "七杀格", "translation": "月令七杀当令，主有魄力、适合竞争性行业、军警管理", "category": "格局"},
    {"term": "正官格", "translation": "月令正官当令，主端正守纪、有管理能力、适合公职", "category": "格局"},
    {"term": "食神格", "translation": "月令食神当令，主温和平顺、有口福、才华内敛", "category": "格局"},
    {"term": "伤官格", "translation": "月令伤官当令，主聪明傲气、才华外露、口才好", "category": "格局"},
    {"term": "正财格", "translation": "月令正财当令，主勤劳节俭、善于理财", "category": "格局"},
    {"term": "偏财格", "translation": "月令偏财当令，主人豪爽大方、人缘好、善交际", "category": "格局"},
    {"term": "从财格", "translation": "您命里财星极旺，日主极弱，只能顺从财势。适合经商、金融，不宜公职、合伙", "category": "格局"},
    {"term": "从官杀格", "translation": "命里官杀极旺，日主极弱，顺从权威。适合公职、管理、军警", "category": "格局"},
    {"term": "从儿格", "translation": "命里食伤极旺，日主极弱，顺从才华之势。利文艺、技术、创意", "category": "格局"},
    {"term": "化气格", "translation": "天干合化成功，五行本性改变，以化神五行为核心", "category": "格局"},
    {"term": "专旺格", "translation": "命局五行专旺归一，气势极盛，只能顺不能逆", "category": "格局"},
    {"term": "两气成象格", "translation": "命局中两种五行各占一半，气势分明，格局清朗", "category": "格局"},
    {"term": "建禄格", "translation": "月支为日干的临官位，日主得禄，身旺有根", "category": "格局"},
    {"term": "阳刃格", "translation": "月支为日干的帝旺位，日主极旺刚烈，需官杀制之", "category": "格局"},
    {"term": "杀印相生", "translation": "压力（七杀）转化为动力（印星），适合管理、军警、技术攻坚，压力越大成就越高", "category": "十神组合"},
    {"term": "伤官见官", "translation": "伤官与正官同时出现，容易与上级冲突、法律纠纷、婚姻不顺", "category": "十神组合"},
    {"term": "伤官佩印", "translation": "伤官有印星制约，才华有收敛，利学术、教育、高端技术", "category": "十神组合"},
    {"term": "食神生财", "translation": "靠才华和技能赚钱，利商业、技术创业、专业服务", "category": "十神组合"},
    {"term": "财官相生", "translation": "因财生官，名利双收，利仕途", "category": "十神组合"},
    {"term": "贪财坏印", "translation": "为了钱财损害了名誉、学历、信用、贵人关系", "category": "十神组合"},
    {"term": "枭神夺食", "translation": "偏印克制食神，才华被压制，事业多阻碍，容易半途而废", "category": "十神组合"},
    {"term": "官杀混杂", "translation": "正官和七杀同时出现，管理混乱、压力多重、感情多纠葛", "category": "十神组合"},
    {"term": "财多身弱", "translation": "看着有钱但实际压力大，赚钱辛苦，需要帮手才能担财", "category": "十神组合"},
    {"term": "身旺任财", "translation": "自身能力强又有赚钱机会，身财两停，是富命的标志", "category": "十神组合"},
    {"term": "用神", "translation": "对您命局最有利的五行，是分析的核心", "category": "核心概念"},
    {"term": "忌神", "translation": "对您命局最不利的五行，需要尽量避开", "category": "核心概念"},
    {"term": "喜神", "translation": "生助用神的五行，间接对您有利", "category": "核心概念"},
    {"term": "仇神", "translation": "生助忌神的五行，间接对您不利", "category": "核心概念"},
    {"term": "调候", "translation": "调节命局的寒暖燥湿，冬生需火暖，夏生需水润", "category": "核心概念"},
    {"term": "通关", "translation": "在两种相克的五行之间引入第三种五行化解冲突", "category": "核心概念"},
    {"term": "格局", "translation": "根据月令（出生月份）确定的命局基本类型，决定了一生的主要倾向", "category": "核心概念"},
    {"term": "大运", "translation": "每十年转换一次的运势周期，影响这十年的整体吉凶", "category": "核心概念"},
    {"term": "流年", "translation": "当年的天干地支，决定这一年的具体运势变化", "category": "核心概念"},
    {"term": "四柱", "translation": "年柱、月柱、日柱、时柱，分别代表祖上、父母、自己、子女", "category": "核心概念"},
    {"term": "日主", "translation": "日柱的天干，代表您自己，是八字分析的核心", "category": "核心概念"},
    {"term": "月令", "translation": "月柱的地支，代表出生月份的五行气场，是定格的关键", "category": "核心概念"},
    {"term": "巳亥冲", "translation": "地支相冲，主奔波、环境变动，可能换工作或搬家", "category": "地支关系"},
    {"term": "子午冲", "translation": "地支相冲，主内心矛盾、家庭变动、感情波折", "category": "地支关系"},
    {"term": "寅申冲", "translation": "地支相冲，主出行、迁移、事业变动", "category": "地支关系"},
    {"term": "卯酉冲", "translation": "地支相冲，主感情变动、合作变化、身体意外", "category": "地支关系"},
    {"term": "辰戌冲", "translation": "地支相冲，主房产变动、合同纠纷、官司", "category": "地支关系"},
    {"term": "丑未冲", "translation": "地支相冲，主脾胃健康、土地房产、人际关系变化", "category": "地支关系"},
    {"term": "六合", "translation": "地支相合，主合作、亲近、稳定、贵人", "category": "地支关系"},
    {"term": "三合局", "translation": "三个地支合成一个五行局，力量极大，代表大势所趋", "category": "地支关系"},
    {"term": "三会方", "translation": "三个相邻地支会成一方之气，力量最大，代表一方极旺", "category": "地支关系"},
    {"term": "三刑", "translation": "地支相刑，主官非、伤病、纠缠、是非，需要特别注意", "category": "地支关系"},
    {"term": "六害", "translation": "地支相害，主暗中小人、不和、暗中损失", "category": "地支关系"},
    {"term": "天乙贵人", "translation": "命中最大的吉神，一生遇贵人扶持，逢凶化吉", "category": "神煞"},
    {"term": "文昌贵人", "translation": "利考试、文职、学术的吉神，主人聪明好学", "category": "神煞"},
    {"term": "桃花（咸池）", "translation": "主人缘好、异性缘、风流、艺术天赋", "category": "神煞"},
    {"term": "驿马", "translation": "主奔波、出行、迁移、变动，驿马多的人一生多走动", "category": "神煞"},
    {"term": "华盖", "translation": "主聪明、孤独、宗教缘、艺术天赋，华盖多的人喜欢独处思考", "category": "神煞"},
    {"term": "将星", "translation": "主权威、领导力、组织能力", "category": "神煞"},
    {"term": "羊刃", "translation": "刚烈过旺的标志，主血光、手术、刑伤，也主武职", "category": "神煞"},
    {"term": "魁罡", "translation": "聪明果断、有领导力，但性格刚烈，婚姻不利", "category": "神煞"},
    {"term": "空亡", "translation": "某个地支在该旬中不存在，主虚、不实、落空，填实后反而有力", "category": "神煞"},
    {"term": "孤辰寡宿", "translation": "主孤独、独立、亲情淡薄，感情上容易孤独", "category": "神煞"},
    {"term": "天克地冲", "translation": "流年与命局某柱天干相克地支相冲，主重大变动、转折、分离", "category": "流年概念"},
    {"term": "岁运并临", "translation": "流年干支与大运干支完全相同，吉凶加倍", "category": "流年概念"},
    {"term": "伏吟", "translation": "流年地支与命局某柱相同，主抑郁反复、停滞不前", "category": "流年概念"},
    {"term": "反吟", "translation": "流年地支与命局某柱相冲，主变动冲击", "category": "流年概念"},
    {"term": "值太岁（本命年）", "translation": "流年地支与年支相同，吉凶皆放大，需低调谨慎", "category": "流年概念"},
    {"term": "冲太岁", "translation": "流年地支与年支相冲，主变动、冲突、出行需注意安全", "category": "流年概念"},
    {"term": "贪财坏印", "translation": "为了利益损害了规则、信用、资质、名誉", "category": "十神组合"},
    {"term": "身强", "translation": "日主力量充足，能担财官，适合积极进取", "category": "身强身弱"},
    {"term": "身弱", "translation": "日主力量不足，担不起太多财官，需要印比帮扶", "category": "身强身弱"},
    {"term": "身旺", "translation": "日主力量过旺，需要食伤泄秀或财星耗身", "category": "身强身弱"},
    {"term": "十二长生", "translation": "五行从生到死的十二个阶段：长生、沐浴、冠带、临官、帝旺、衰、病、死、墓、绝、胎、养", "category": "核心概念"},
    {"term": "纳音", "translation": "六十甲子对应的另一种五行分类方式，如甲子海中金、丙寅炉中火", "category": "核心概念"},
    {"term": "藏干", "translation": "每个地支中暗藏的天干，决定了地支的真正五行属性", "category": "核心概念"},
    {"term": "地支藏干", "translation": "每个地支里面暗藏的天干，主气决定月令格局，中气和余气次之", "category": "核心概念"},
    {"term": "真太阳时", "translation": "根据出生地经度校正后的当地时间，用于确定准确的时辰", "category": "排盘概念"},
    {"term": "节气", "translation": "二十四节气中的十二节（立春、惊蛰等），用于划分月令，不是农历初一", "category": "排盘概念"},
    {"term": "换运", "translation": "每十年一次的大运转换，交接前后一年为动荡期，宜守不宜攻", "category": "大运概念"},
    {"term": "起运", "translation": "开始行大运的年龄，由出生日到最近节气的天数除以三计算", "category": "大运概念"},
    {"term": "命限", "translation": "人生不同阶段的运势分区：少年看年柱、青年看月柱、中年看日柱、晚年看时柱", "category": "核心概念"},
    {"term": "夫妻宫", "translation": "日柱的地支（日支），代表婚姻和配偶", "category": "宫位"},
    {"term": "事业宫", "translation": "月柱代表事业基础，官杀星代表事业高度", "category": "宫位"},
    {"term": "财帛宫", "translation": "日支和时支都与财运相关，财星代表赚钱能力", "category": "宫位"},
    {"term": "子女宫", "translation": "时柱代表子女和晚年运势", "category": "宫位"},
    {"term": "父母宫", "translation": "年柱代表祖上和父母，印星代表母亲", "category": "宫位"},
    {"term": "身财两停", "translation": "自身力量与财星力量均衡，既有赚钱能力又有赚钱机会，是富命的标志", "category": "十神组合"},
    {"term": "偏枯", "translation": "命局五行严重失衡，某一种或两种五行过旺或过弱，主人生波折较大", "category": "核心概念"},
    {"term": "中和", "translation": "命局五行平衡流通，既不太过也不不及，主一生平顺少波折", "category": "核心概念"},
    {"term": "偏旺", "translation": "日主力量偏强但未到极旺的程度，需要适当泄耗", "category": "身强身弱"},
    {"term": "太弱", "translation": "日主力量极弱，几乎无根无助，需要印比全力帮扶", "category": "身强身弱"},
    {"term": "得令", "translation": "日主或某十神在月令（出生月份）处于旺相状态，力量最强", "category": "核心概念"},
    {"term": "失令", "translation": "日主或某十神在月令处于休囚死绝状态，力量最弱", "category": "核心概念"},
    {"term": "得地", "translation": "日主或某十神在地支有根（长生、帝旺、禄等），力量有依托", "category": "核心概念"},
    {"term": "失地", "translation": "日主或某十神在地支无根，力量虚浮不实", "category": "核心概念"},
    {"term": "得势", "translation": "天干有同类五行帮扶，形成党势，力量增强", "category": "核心概念"},
    {"term": "天透地藏", "translation": "某十神既在天干透出，又在地支有根，力量完整可靠", "category": "核心概念"},
    {"term": "虚浮无根", "translation": "某五行只在天干出现，地支完全没有根气，力量极弱不可靠", "category": "核心概念"},
    {"term": "旺相休囚死", "translation": "五行在四季中的五种状态：当令为旺、次旺为相、渐衰为休、衰弱为囚、最弱为死", "category": "核心概念"},
    {"term": "进气退气", "translation": "五行在即将到来的季节为进气（渐旺），在即将离去的季节为退气（渐衰）", "category": "核心概念"},
    {"term": "生化有情", "translation": "命局五行之间相生关系顺畅，没有严重冲克，主人生顺遂", "category": "核心概念"},
    {"term": "贪生忘克", "translation": "某五行本来应该克制另一五行，但因为中间有相生关系而转生不克", "category": "核心概念"},
    {"term": "克泄交加", "translation": "日主同时被克（官杀）和被泄（食伤），两面受压，主压力大", "category": "十神组合"},
    {"term": "印绶重叠", "translation": "命局中印星过多，身旺无泄反为忌，主人依赖性强、优柔寡断", "category": "十神组合"},
    {"term": "比劫夺财", "translation": "比肩劫财过多，争夺财星，主破财、克妻、合伙不利", "category": "十神组合"},
    {"term": "食伤泄秀", "translation": "日主旺极时通过食神伤官泄去多余力量，转化为才华和创造力", "category": "十神组合"},
    {"term": "财气通门户", "translation": "财星与食伤、官杀配合得当，财气流通不滞，是富命的标志", "category": "十神组合"},
    {"term": "官星有理会", "translation": "官星与印星、财星配合得当，官星有情有力，是贵命的标志", "category": "十神组合"},
    {"term": "有病得药", "translation": "命局虽有缺陷（病），但有对应的解决五行（药），反而能成就大事", "category": "核心概念"},
    {"term": "旺极宜泄不宜克", "translation": "日主旺到极点时，应该用食伤泄秀而不是用官杀克制，克制反而激怒", "category": "核心概念"},
    {"term": "昆仑之水可顺不可逆", "translation": "水势极旺时只能顺其势而行，不可逆势而制，否则反受其害", "category": "核心概念"},
    {"term": "财多身弱富屋贫人", "translation": "财星很多但日主太弱担不起，看着有钱实际赚不到手或留不住", "category": "十神组合"},
    {"term": "杀重身轻需印化", "translation": "七杀过重日主太弱时，需要印星化解七杀的力量来生助日主", "category": "十神组合"},
    {"term": "木火通明", "translation": "命局木火两旺相生，主人聪慧文雅利文职学术", "category": "格局"},
    {"term": "金白水清", "translation": "命局金水两旺相生，主人聪秀清丽利学术技艺", "category": "格局"},
    {"term": "木土相战", "translation": "命局中木土两行相克，主人易有脾胃健康问题，做事多阻碍", "category": "地支关系"},
    {"term": "水火既济", "translation": "水火两行力量均衡且有通关，主人智慧通达", "category": "地支关系"},
    {"term": "五行偏枯", "translation": "命局五行严重失衡，某行过旺或过弱，主人生有较大波折", "category": "核心概念"},
    {"term": "五行流通", "translation": "命局五行依次相生不断，气势流通无阻，主一生顺遂", "category": "核心概念"},
    {"term": "四柱不悖", "translation": "四柱干支之间没有严重的冲克刑害，配合和谐", "category": "核心概念"},
    {"term": "用神无力", "translation": "虽然找到了用神但力量太弱，帮不上忙，命局层次降低", "category": "核心概念"},
    {"term": "忌神太过", "translation": "忌神力量过强且无法制化，主人生有较大困扰", "category": "核心概念"},
    {"term": "岁运并临", "translation": "流年干支与大运干支完全相同，吉凶加倍放大", "category": "流年概念"},
    {"term": "真从假从", "translation": "真从格日主完全无根无条件顺从；假从格日主虽弱但仍有微根，需兼顾扶抑", "category": "格局"},
    {"term": "化神有根", "translation": "天干合化后，化神五行在地支有根气，化气格才能成立", "category": "格局"},
    {"term": "争合妒合", "translation": "两个相同天干争合一个天干（如两甲合一己），合化不成反为阻碍", "category": "核心概念"}
  ]
}
