{
  "meta": {"description": "专旺格喜忌行运规则", "version": "1.0.0", "source": "渊海子平"},
  "patterns": [
    {"name": "曲直仁寿格行运", "xi_yun": ["水运","木运"], "ji_yun": ["金运","土运"], "note": "金克木为最大忌"},
    {"name": "炎上格行运", "xi_yun": ["木运","火运"], "ji_yun": ["水运","土运"], "note": "水克火为最大忌"},
    {"name": "稼穑格行运", "xi_yun": ["火运","土运"], "ji_yun": ["木运","水运"], "note": "木克土为最大忌"},
    {"name": "从革格行运", "xi_yun": ["土运","金运"], "ji_yun": ["火运","木运"], "note": "火克金为最大忌"},
    {"name": "润下格行运", "xi_yun": ["金运","水运"], "ji_yun": ["土运","木运"], "note": "土克水为最大忌"}
