{
  "meta": {"description": "两气成象格喜忌行运规则", "version": "1.0.0", "source": "滴天髓"},
  "patterns": [
    {"name": "木火通明行运", "xi_yun": ["木运","火运"], "ji_yun": ["金运","水运"], "note": "金克木为忌"},
    {"name": "火土相资行运", "xi_yun": ["火运","土运"], "ji_yun": ["水运","木运"], "note": "水克火为忌"},
    {"name": "土金相生行运", "xi_yun": ["土运","金运"], "ji_yun": ["火运","木运"], "note": "火克金为忌"},
    {"name": "金白水清行运", "xi_yun": ["金运","水运"], "ji_yun": ["土运","火运"], "note": "土克水为忌"},
    {"name": "水木清华行运", "xi_yun": ["水运","木运"], "ji_yun": ["土运","金运"], "note": "金克木为忌"},
    {"name": "金木相成行运", "xi_yun": ["水运（通关）"], "ji_yun": ["火运","土运"], "note": "通关运最关键"},
    {"name": "水火既济行运", "xi_yun": ["木运（通关）"], "ji_yun": ["土运","金运"], "note": "通关运最关键"}
  ],
  "core_principle": "两气成象格喜助本象两行，忌引入第三行克战。相战型需通关运",
  "source": "《滴天髓》"
}
