{
  "meta": {"description": "化气格喜忌行运规则", "version": "1.0.0", "source": "渊海子平、三命通会"},
  "patterns": [
    {"name": "甲己化土行运", "xi_yun": ["火运","土运"], "ji_yun": ["木运","水运"], "note": "木克土为最大忌"},
    {"name": "乙庚化金行运", "xi_yun": ["土运","金运"], "ji_yun": ["火运","木运"], "note": "火克金为最大忌"},
    {"name": "丙辛化水行运", "xi_yun": ["金运","水运"], "ji_yun": ["土运","木运"], "note": "土克水为最大忌"},
    {"name": "丁壬化木行运", "xi_yun": ["水运","木运"], "ji_yun": ["金运","土运"], "note": "金克木为最大忌"},
    {"name": "戊癸化火行运", "xi_yun": ["木运","火运"], "ji_yun": ["水运","土运"], "note": "水克火为最大忌"}
  ],
  "core_principle": "化气格以化神五行为用，喜生助化神，忌克泄化神",
  "source": "《渊海子平》"
